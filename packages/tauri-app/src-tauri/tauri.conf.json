{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cloud Drive Sync",
	"version": "1.0.2",
	"identifier": "family.merlot.cloud-drive-sync",
	"build": {
		"beforeDevCommand": "vite",
		"beforeBuildCommand": "vite build",
		"devUrl": "http://localhost:1421",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Cloud Drive Sync",
				"width": 460,
				"height": 680,
				"resizable": false,
				"maximizable": false,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns"
		],
		"macOS": {
			"hardenedRuntime": true
		}
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/sm-merlot/cloud-drive-sync/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxN0YwREEyMDg1RTNDRTMKUldUalBGNElvZzEvSWNYSG45akRKeEtZNFdWcys0Y3hHUk9KN0t1bS9lanZ0NjFTdG1ZK3JISWEK"
		}
	}
}
