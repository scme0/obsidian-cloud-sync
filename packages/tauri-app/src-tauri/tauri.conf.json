{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cloud Drive Sync",
	"version": "0.1.0",
	"identifier": "family.merlot.cloud-drive-sync",
	"build": {
		"beforeDevCommand": "vite",
		"beforeBuildCommand": "vite build",
		"devUrl": "http://localhost:1421",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Cloud Drive Sync",
				"width": 480,
				"height": 640,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app", "dmg"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns"
		],
		"macOS": {
			"hardenedRuntime": true
		}
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/sm-merlot/cloud-drive-sync/releases/latest/download/latest.json"
			],
			"pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY"
		}
	}
}
