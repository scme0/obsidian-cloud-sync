{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capabilities for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"fs:default",
		"fs:allow-watch",
		"fs:allow-read-dir",
		"fs:allow-read-file",
		"fs:allow-write-file",
		"fs:allow-remove",
		"fs:allow-mkdir",
		"fs:allow-exists",
		"fs:allow-stat",
		"fs:scope-app-recursive",
		"dialog:default",
		"store:default",
		"updater:default",
		"process:default",
		{
			"identifier": "http:default",
			"allow": [
				{ "url": "http://**" },
				{ "url": "https://**" }
			]
		},
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "**" }]
		}
	]
}
